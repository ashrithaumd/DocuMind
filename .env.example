# Copy to .env and fill in. docker-compose reads this file automatically.

# LLM provider for ALL reasoning calls (generation + relevance/groundedness
# checks): gemini (default, Google AI Studio free tier) or anthropic.
# The same Gemini key also serves the default embeddings (see below).
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-key-here
# Only needed when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Raw provider error text and per-request LLM usage come back from /query
# only for admins; everyone else gets provider-neutral errors (details go
# to the server log). There is no global switch.
# Optional model overrides; empty = the provider's defaults in config.py
# (gemini: gemini-3.5-flash-lite for both,
#  anthropic: claude-opus-4-8 / claude-haiku-4-5).
# For demos, GENERATION_MODEL=gemini-3.6-flash gives stronger answers, but the
# free tier allows it only 20 requests/day (failed attempts count too).
GENERATION_MODEL=
GRADING_MODEL=
# Gemini thinking level for the relevance/groundedness checks
# (minimal|low|medium|high; empty = model default). Default: minimal.
# GRADING_THINKING_LEVEL=minimal

# Embeddings: gemini (default: gemini-embedding-2 with GEMINI_API_KEY, 1536
# dims) or local (sentence-transformers all-MiniLM-L6-v2, no key, CPU).
# Changing the provider, model or dimension means a fresh database and
# re-ingesting your documents (the backend refuses a mismatched index).
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL=
# EMBEDDING_DIMENSIONS=   (default: 384 for MiniLM, 1536 for gemini-embedding-2)
# Vertex AI instead of the Gemini API key (needs billing and application
# default credentials):
# EMBEDDING_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=us-central1

# Postgres credentials (compose builds both URLs below from these).
# POSTGRES_USER owns the tables; only the one-shot `migrate` service uses
# it. The backend connects as documind_app, which row-level security
# applies to (it refuses to start as a superuser or owner, or with
# MIGRATION_DATABASE_URL set); the migrate step sets that role's password
# from APP_DB_PASSWORD on every run. Required: compose fails without it.
POSTGRES_USER=documind
POSTGRES_PASSWORD=change-me
POSTGRES_DB=documind
APP_DB_PASSWORD=change-me-too

# Host ports (defaults 3000 web / 8000 API; change if something else owns them).
# FRONTEND_PORT=3001
# BACKEND_PORT=8001

# For running the backend OUTSIDE docker (uvicorn on the host), set:
# DATABASE_URL=postgresql+psycopg2://documind_app:change-me-too@localhost:5432/documind
# and run the migrate step first, with the owner URL given only to it:
#   MIGRATION_DATABASE_URL=postgresql+psycopg2://documind:change-me@localhost:5432/documind python migrate.py
# (Don't put MIGRATION_DATABASE_URL in this file: the backend would refuse to start.)
# (required: Postgres with the pgvector extension holds the chunks; e.g.
#  docker compose up postgres, which runs pgvector/pgvector:0.8.7-pg16)

# Firebase Auth. Every endpoint except /me and /health needs a Firebase ID
# token (Authorization: Bearer ...) from a user set up in Postgres.
# Required: tokens are only accepted for this project.
FIREBASE_PROJECT_ID=your-project-id
# Seconds of clock difference tolerated on token times (0-60, default 5).
# FIREBASE_CLOCK_SKEW_SECONDS=5
# Web config (VITE_*): public, read by the frontend build for its sign-in
# screen (from this file in dev, as build args in docker-compose).
# The service account key is NOT public: keep the file OUTSIDE this repo and
# point to it by absolute path. Required: the backend can't check sign-in
# tokens without it and refuses to start. docker-compose mounts this file
# read-only into the backend; it is never copied into an image.
# CI fails if a key file is committed.
GOOGLE_APPLICATION_CREDENTIALS=C:/secrets/documind-firebase-adminsdk.json
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
