# Copy to .env and fill in. docker-compose reads this file automatically.

# LLM provider for ALL reasoning calls (generation + relevance/groundedness
# checks): gemini (default, Google AI Studio free tier) or anthropic.
# Embeddings are local (sentence-transformers) and need no key at all.
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-key-here
# Only needed when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Return raw provider error text and per-request LLM usage from /query
# (default false: clients get provider-neutral errors, details go to the
# server log). Set true only for the backend an eval run talks to.
# EXPOSE_LLM_DIAGNOSTICS=false
# Optional model overrides; empty = the provider's defaults in config.py
# (gemini: gemini-3.5-flash-lite for both,
#  anthropic: claude-opus-4-8 / claude-haiku-4-5).
# For demos, GENERATION_MODEL=gemini-3.6-flash gives stronger answers, but the
# free tier allows it only 20 requests/day (failed attempts count too).
GENERATION_MODEL=
GRADING_MODEL=
# Gemini thinking level for the relevance/groundedness checks
# (minimal|low|medium|high; empty = model default). Default: minimal.
# GRADING_THINKING_LEVEL=minimal

# Embeddings: gemini (default: gemini-embedding-2 with GEMINI_API_KEY, 1536
# dims) or local (sentence-transformers all-MiniLM-L6-v2, no key, CPU).
# Changing the provider, model or dimension means a fresh database and
# re-ingesting your documents (the backend refuses a mismatched index).
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL=
# EMBEDDING_DIMENSIONS=   (default: 384 for MiniLM, 1536 for gemini-embedding-2)
# Vertex AI instead of the Gemini API key (needs billing and application
# default credentials):
# EMBEDDING_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=us-central1

# Optional — when set, every endpoint (except /health) requires this value
# in the X-API-Key header. Leave empty to disable auth for local dev.
API_KEY=

# Postgres credentials (compose builds DATABASE_URL from these).
POSTGRES_USER=documind
POSTGRES_PASSWORD=change-me
POSTGRES_DB=documind

# Host ports (defaults 3000 web / 8000 API; change if something else owns them).
# FRONTEND_PORT=3001
# BACKEND_PORT=8001

# For running the backend OUTSIDE docker (uvicorn on the host), also set:
# DATABASE_URL=postgresql+psycopg2://documind:change-me@localhost:5432/documind
# (required: Postgres with the pgvector extension holds the chunks; e.g.
#  docker compose up postgres, which runs pgvector/pgvector:0.8.7-pg16)
